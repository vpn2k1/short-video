{
  "title": "Không sợ thất tình – lý do bất ngờ",
  "subtitle": "Tôi chưa từng có người yêu, vì vậy không lo mất người",
  "accent": "#ff6b2c",
  "background": "#0f1115",
  "captions": [
    {
      "text": "Bạn có biết vì sao tôi không bao giờ sợ thất tình không?",
      "startMs": 2483,
      "endMs": 6353,
      "audio": "voices/ban-co-biet-vi-sao-toi-khong-bao-gio-so/edit-1790244845178/line-01.mp3"
    },
    {
      "text": "Bởi vì từ nhỏ đến lớn, tôi đã có người yêu đâu mà thất.",
      "startMs": 6902,
      "endMs": 11152,
      "audio": "voices/ban-co-biet-vi-sao-toi-khong-bao-gio-so/edit-1790244845178/line-02.mp3"
    },
    {
      "text": "Người ta yêu nhau thì sợ chia tay.",
      "startMs": 11903,
      "endMs": 14133,
      "audio": "voices/ban-co-biet-vi-sao-toi-khong-bao-gio-so/edit-1790244845178/line-03.mp3"
    },
    {
      "text": "Còn tôi, đến nắm tay con gái còn chưa có cơ hội.",
      "startMs": 14753,
      "endMs": 18213,
      "audio": "voices/ban-co-biet-vi-sao-toi-khong-bao-gio-so/edit-1790244845178/line-04.mp3"
    },
    {
      "text": "Tôi không phải người chung tình…",
      "startMs": 19362,
      "endMs": 21252,
      "audio": "voices/ban-co-biet-vi-sao-toi-khong-bao-gio-so/edit-1790244845178/line-05.mp3"
    },
    {
      "text": "Tôi chỉ là người chưa có đối tượng để phản bội thôi.",
      "startMs": 21635,
      "endMs": 24825,
      "audio": "voices/ban-co-biet-vi-sao-toi-khong-bao-gio-so/edit-1790244845178/line-06.mp3"
    }
  ],
