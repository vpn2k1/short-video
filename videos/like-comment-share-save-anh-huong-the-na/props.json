  "captions": [
    {
      "text": "Bạn nghĩ một Like chỉ là lời khen?",
      "startMs": 2483,
      "endMs": 4871,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-01.mp3"
    },
    {
      "text": "Thực ra nó quyết định độ hiển thị bài viết",
      "startMs": 5521,
      "endMs": 8286,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-02.mp3"
    },
    {
      "text": "Comment khiến thuật toán coi nội dung quan trọng",
      "startMs": 8936,
      "endMs": 11752,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-03.mp3"
    },
    {
      "text": "Câu trả lời, câu hỏi, hay cảm xúc đều tăng độ lan truyền",
      "startMs": 12002,
      "endMs": 16446,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-04.mp3"
    },
    {
      "text": "Share là phép nhân, mỗi lần chia sẻ kéo thêm người xem",
      "startMs": 17096,
      "endMs": 20907,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-05.mp3"
    },
    {
      "text": "Nội dung được chia sẻ ba lần sẽ đạt tới gấp ba lượt xem",
      "startMs": 21157,
      "endMs": 25143,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-06.mp3"
    },
    {
      "text": "Save cho biết nội dung có giá trị lâu dài",
      "startMs": 25793,
      "endMs": 29161,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-07.mp3"
    },
    {
      "text": "Thuật toán ưu tiên nội dung được lưu lại",
      "startMs": 29411,
      "endMs": 31920,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-08.mp3"
    },
    {
      "text": "Hãy tương tác thông minh, tăng tầm ảnh hưởng của bạn",
      "startMs": 32570,
      "endMs": 36025,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-09.mp3"
    },
    {
      "text": "Follow để nhận thêm mẹo nhanh",
      "startMs": 36275,
      "endMs": 38309,
      "audio": "voices/like-comment-share-save-anh-huong-the-na/line-10.mp3"
    }
  ],
