{
  "title": "Dế Mèn và người hàng xóm",
  "subtitle": "",
  "handle": "@ketruyen",
  "accent": "#f4a300",
  "background": "#12180e",
  "captions": [
    {
      "text": "Dưới những ngọn cỏ tưởng như bình",
      "startMs": 40,
      "endMs": 1560,
      "audio": null
    },
    {
      "text": "thường, tồn tại cả một thế giới khổng lồ,",
      "startMs": 1560,
      "endMs": 4730,
      "audio": null
    },
    {
      "text": "và trong chiếc hang này, có một chàng dế",
      "startMs": 4730,
      "endMs": 6920,
      "audio": null
    },
    {
      "text": "đang rất tự hào về chính mình,",
      "startMs": 6920,
      "endMs": 8840,
      "audio": null
    },
    {
      "text": "đó là Dế Mèn.",
      "startMs": 8840,
      "endMs": 10000,
      "audio": null
    },
    {
      "text": "Cậu còn trẻ nhưng đã có một thân hình khỏe",
      "startMs": 10000,
      "endMs": 12930,
      "audio": null
    },
    {
      "text": "mạnh và đôi càng khiến cậu vô cùng đắc ý.",
      "startMs": 12930,
      "endMs": 16150,
      "audio": null
    },
    {
      "text": "Mèn thích đi lại nghênh ngang quanh xóm.",
      "startMs": 16150,
      "endMs": 18000,
      "audio": null
    },
    {
      "text": "Thấy mình khỏe hơn những con vật khác,",
      "startMs": 18000,
      "endMs": 20000,
      "audio": null
    },
    {
      "text": "cậu bắt đầu nghĩ chẳng ai đáng để mình",
      "startMs": 20000,
      "endMs": 22380,
      "audio": null
    },
    {
      "text": "phải sợ.",
      "startMs": 22380,
      "endMs": 23000,
      "audio": null
    },
    {
      "text": "Ngay cạnh nhà Mèn lại có một người hàng",
      "startMs": 23000,
      "endMs": 25420,
      "audio": null
    },
    {
      "text": "xóm hoàn toàn khác, một chú dế gầy yếu,",
      "startMs": 25420,
      "endMs": 27970,
      "audio": null
    },
    {
      "text": "sống trong chiếc hang nhỏ sơ sài,",
      "startMs": 27970,
      "endMs": 29920,
      "audio": null
    },
    {
      "text": "Dế Choắt.",
      "startMs": 29920,
      "endMs": 31000,
      "audio": null
    },
    {
      "text": "Dế Choắt biết chiếc hang của mình rất",
      "startMs": 31000,
      "endMs": 33200,
      "audio": null
    },
    {
      "text": "nguy hiểm, vì vậy cậu quyết định sang nhờ",
      "startMs": 33200,
      "endMs": 35610,
      "audio": null
    },
    {
      "text": "Dế Mèn giúp một việc, nhưng câu trả lời",
      "startMs": 35610,
      "endMs": 38150,
      "audio": null
    },
    {
      "text": "của Mèn sẽ khiến mọi chuyện bắt đầu thay",
      "startMs": 38150,
      "endMs": 40260,
      "audio": null
    },
    {
      "text": "đổi.",
      "startMs": 40260,
      "endMs": 41000,
      "audio": null
    }
  ],
  "scenes": [
    {
      "image": "images/de-men/co-cao.png",
