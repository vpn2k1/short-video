{
  "title": "Gửi tôi của 10 năm trước",
  "subtitle": "Những điều ước gì mình biết sớm hơn",
  "handle": "@kenh",
  "accent": "#ff6b2c",
  "background": "#0f1115",
  "captions": [
    {
      "text": "Chào cậu, mình là cậu của mười năm sau.",
      "startMs": 2483,
      "endMs": 4883,
      "audio": "voices/gui-toi-cua-10-nam-truoc/line-01.mp3"
    },
    {
      "text": "Có vài điều mình muốn kể.",
      "startMs": 5033,
      "endMs": 6633,
      "audio": "voices/gui-toi-cua-10-nam-truoc/line-02.mp3"
    },
    {
      "text": "Đừng sợ bắt đầu từ con số không.",
      "startMs": 6783,
      "endMs": 8703,
      "audio": "voices/gui-toi-cua-10-nam-truoc/line-03.mp3"
    },
    {
      "text": "Ai cũng từng vụng về lúc đầu.",
      "startMs": 8853,
      "endMs": 10613,
      "audio": "voices/gui-toi-cua-10-nam-truoc/line-04.mp3"
    },
    {
      "text": "Nghe thì ít, nhưng mười năm là cả một thư viện.",
      "startMs": 10763,
      "endMs": 13483,
      "audio": "voices/gui-toi-cua-10-nam-truoc/line-05.mp3"
    },
    {
      "text": "Cảm ơn cậu đã không bỏ cuộc.",
      "startMs": 13633,
      "endMs": 15313,
      "audio": "voices/gui-toi-cua-10-nam-truoc/line-06.mp3"
    },
    {
      "text": "Hẹn gặp ở phía trước nhé.",
      "startMs": 15463,
      "endMs": 16983,
      "audio": "voices/gui-toi-cua-10-nam-truoc/line-07.mp3"
    }
  ],
