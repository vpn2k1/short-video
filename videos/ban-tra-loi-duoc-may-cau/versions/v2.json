      "audio": "voices/ban-tra-loi-duoc-may-cau/muw6ze0034o/line-57.mp3"
    },
    {
      "text": "B. Can you run?",
      "startMs": 172643,
      "endMs": 174083,
      "audio": "voices/ban-tra-loi-duoc-may-cau/muw6ze0034o/line-58.mp3"
    },
    {
      "text": "C. Can you leave?",
      "startMs": 174733,
      "endMs": 176093,
      "audio": "voices/ban-tra-loi-duoc-may-cau/muw6ze0034o/line-59.mp3"
    },
    {
      "text": "Đáp án là A. Can you wait a minute?",
      "startMs": 179093,
      "endMs": 181493,
      "audio": "voices/ban-tra-loi-duoc-may-cau/muw6ze0034o/line-60.mp3"
    },
    {
      "text": "Bạn đúng được bao nhiêu câu?",
      "startMs": 182543,
      "endMs": 184143,
      "audio": "voices/ban-tra-loi-duoc-may-cau/muw6ze0034o/line-61.mp3"
    },
    {
      "text": "9–10 câu: Excellent! 🌟",
