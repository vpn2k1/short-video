      "audio": "voices/ban-tra-loi-duoc-may-cau/muw6ze0034o/line-54.mp3"
    },
    {
      "text": "Bạn muốn nhờ một người đợi mình một phút.",
      "startMs": 166013,
      "endMs": 167773,
      "audio": "voices/ban-tra-loi-duoc-may-cau/muw6ze0034o/line-55.mp3"
    },
    {
      "text": "Bạn nói câu nào?",
      "startMs": 168223,
      "endMs": 169583,
      "audio": "voices/ban-tra-loi-duoc-may-cau/muw6ze0034o/line-56.mp3"
    },
    {
      "text": "A. Can you wait a minute?",
      "startMs": 170233,
