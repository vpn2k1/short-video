{
  "title": "Ba Giai và Tú Xuất đi ăn",
  "subtitle": "Hai người nghèo bước vào quán sang và nghĩ ra một cách trả tiền rất đặc biệt.",
  "accent": "#ff6b2c",
  "background": "#0f1115",
  "captions": [
    {
      "text": "Ba Giai và Tú Xuất bước vào một quán ăn sang trọng.",
      "startMs": 2483,
      "endMs": 5043,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-01.mp3"
    },
    {
      "text": "Hai người gọi rất nhiều món ngon.",
      "startMs": 5493,
      "endMs": 7253,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-02.mp3"
    },
    {
      "text": "Ăn xong, chủ quán mang hóa đơn ra.",
      "startMs": 7703,
      "endMs": 9783,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-03.mp3"
    },
    {
      "text": "Ba Giai nhìn hóa đơn rồi nói: “Tôi không có tiền.”",
      "startMs": 10633,
      "endMs": 13353,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-04.mp3"
    },
    {
      "text": "Chủ quán tức giận: “Không có tiền mà dám ăn nhiều như vậy?”",
      "startMs": 13803,
      "endMs": 16683,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-05.mp3"
    },
    {
      "text": "Tú Xuất lập tức nói: “Ông đừng lo, chúng tôi có cách trả.”",
      "startMs": 17333,
      "endMs": 20453,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-06.mp3"
    },
    {
      "text": "Chủ quán hỏi: “Cách gì?”",
      "startMs": 21303,
      "endMs": 22663,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-07.mp3"
    },
    {
      "text": "Tú Xuất chỉ vào Ba Giai: “Ông ấy không có tiền.”",
      "startMs": 23313,
      "endMs": 25873,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-08.mp3"
    },
    {
      "text": "Rồi chỉ vào mình: “Tôi cũng không có tiền.”",
      "startMs": 26323,
      "endMs": 28563,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-09.mp3"
    },
    {
      "text": "Hai người nhìn nhau rồi nói: “Vậy coi như chúng tôi đã trả lời câu hỏi của ông rồi!”",
      "startMs": 29013,
      "endMs": 33173,
      "audio": "voices/ba-giai-va-tu-xuat-di-an/mul2tbcv3ic/line-10.mp3"
    }
  ],
