{
  "title": "Bạn có biết vì sao người ta nói không ai khó ba đời không?",
  "subtitle": "Nhà tôi là minh chứng đây!",
  "accent": "#ff6b2c",
  "background": "#0f1115",
  "captions": [
    {
      "text": "Nhà tôi là minh chứng đây!",
      "startMs": 2483,
      "endMs": 3923,
      "audio": "voices/ban-co-biet-vi-sao-nguoi-ta-noi-khong-ai/mugsgxsxeww/line-01.mp3"
    },
    {
      "text": "Đời ông tôi nghèo, đời bố tôi cũng nghèo.",
      "startMs": 4773,
      "endMs": 7253,
      "audio": "voices/ban-co-biet-vi-sao-nguoi-ta-noi-khong-ai/mugsgxsxeww/line-02.mp3"
    },
    {
      "text": "Đến đời tôi thì nghèo đến mức tiền lấy vợ còn không có.",
      "startMs": 7703,
      "endMs": 10583,
      "audio": "voices/ban-co-biet-vi-sao-nguoi-ta-noi-khong-ai/mugsgxsxeww/line-03.mp3"
    },
    {
      "text": "Nghĩ kỹ mới thấy câu này đúng thật!",
      "startMs": 11433,
      "endMs": 13193,
      "audio": "voices/ban-co-biet-vi-sao-nguoi-ta-noi-khong-ai/mugsgxsxeww/line-04.mp3"
    },
    {
      "text": "Vì tôi mà nghèo thế này thì lấy đâu ra vợ, không có vợ thì lấy đâu ra con?",
      "startMs": 14043,
      "endMs": 17803,
      "audio": "voices/ban-co-biet-vi-sao-nguoi-ta-noi-khong-ai/mugsgxsxeww/line-05.mp3"
    },
    {
      "text": "Nhà tôi không phải hết nghèo sau ba đời… mà là hết luôn đời thứ tư!",
      "startMs": 18853,
      "endMs": 22613,
      "audio": "voices/ban-co-biet-vi-sao-nguoi-ta-noi-khong-ai/mugsgxsxeww/line-06.mp3"
    }
  ],
