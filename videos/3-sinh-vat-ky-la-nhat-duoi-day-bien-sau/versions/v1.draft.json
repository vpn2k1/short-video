{
  "title": "3 Quái Thú Đáy Biển Sâu",
  "subtitle": "Khám phá các sinh vật kỳ dị dưới lòng đại dương",
  "handle": "@khamphadaiduong",
  "accent": "#00F0FF",
  "background": "#070d18",
  "captions": [
    {
      "text": "Sinh vật ngoài hành tinh sống dưới đáy biển.",
      "startMs": 2483,
      "endMs": 5261,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-01.mp3"
    },
    {
      "text": "Đáy đại dương ẩn chứa những quái thú kỳ dị tới khó tin.",
      "startMs": 5711,
      "endMs": 9454,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-02.mp3"
    },
    {
      "text": "Cá mắt trống sở hữu chiếc đầu hoàn toàn trong suốt.",
      "startMs": 10304,
      "endMs": 13527,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-03.mp3"
    },
    {
      "text": "Đôi mắt hình ống màu xanh lá xoay được bên trong hộp sọ.",
      "startMs": 13977,
      "endMs": 17696,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-04.mp3"
    },
    {
      "text": "Mực quỷ khoác lớp màng đen như áo choàng ma cà rồng.",
      "startMs": 18546,
      "endMs": 22081,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-05.mp3"
    },
    {
      "text": "Chúng tự vệ bằng cách phóng ra chất nhầy phát sáng.",
      "startMs": 22531,
      "endMs": 25778,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-06.mp3"
    },
    {
      "text": "Cá cần câu dùng một chiếc cần phát quang để săn mồi.",
      "startMs": 26628,
      "endMs": 29967,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-07.mp3"
    },
    {
      "text": "Hàm răng sắc nhọn nuốt chửng con mồi lớn gấp đôi cơ thể.",
      "startMs": 30417,
      "endMs": 34255,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-08.mp3"
    },
    {
      "text": "Đại dương sâu thẳm vẫn còn hàng triệu bí ẩn chưa được biết tới.",
      "startMs": 35105,
      "endMs": 39208,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-09.mp3"
    },
    {
      "text": "Bạn thấy loài vật nào kỳ dị nhất, hãy bình luận nhé.",
      "startMs": 39658,
      "endMs": 43300,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau/line-10.mp3"
    }
  ],
