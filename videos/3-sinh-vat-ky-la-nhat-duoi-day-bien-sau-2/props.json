{
  "title": "Sinh vật kỳ lạ đáy biển",
  "subtitle": "Bí ẩn từ đại dương sâu thẳm",
  "handle": "@bienducthom",
  "accent": "#00f0ff",
  "background": "#0b0f19",
  "captions": [
    {
      "text": "Sâu 4.000 mét không có ánh sáng.",
      "startMs": 2483,
      "endMs": 4983,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-01.mp3"
    },
    {
      "text": "Những loài sinh vật này sống ở nơi ánh sáng không bao giờ tới.",
      "startMs": 5433,
      "endMs": 9607,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-02.mp3"
    },
    {
      "text": "Cá rồng biển sở hữu hàm răng sắc nhọn như kim.",
      "startMs": 10457,
      "endMs": 13656,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-03.mp3"
    },
    {
      "text": "Chúng săn mồi trong bóng tối hoàn toàn bằng ánh sáng sinh học.",
      "startMs": 14106,
      "endMs": 17806,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-04.mp3"
    },
    {
      "text": "Mực ma quỷ có lớp da đỏ rực và màng bơi kỳ dị.",
      "startMs": 18656,
      "endMs": 22249,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-05.mp3"
    },
    {
      "text": "Chúng trôi dạt như những chiếc ô sống ở vùng nước lạnh.",
      "startMs": 22699,
      "endMs": 25946,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-06.mp3"
    },
    {
      "text": "Cá giọt nước mang khuôn mặt buồn bã nổi tiếng thế giới.",
      "startMs": 26796,
      "endMs": 30321,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-07.mp3"
    },
    {
      "text": "Cơ thể chúng giống như một khối thạch gelatin khổng lồ.",
      "startMs": 30771,
      "endMs": 34540,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-08.mp3"
    },
    {
      "text": "Áp lực nước ở đây lớn gấp hàng trăm lần trên cạn.",
      "startMs": 35390,
      "endMs": 38595,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-09.mp3"
    },
    {
      "text": "Hãy bảo vệ hành tinh xanh và các loài sinh vật kỳ diệu này.",
      "startMs": 39045,
      "endMs": 43150,
      "audio": "voices/3-sinh-vat-ky-la-nhat-duoi-day-bien-sau-2/line-10.mp3"
    }
  ],
