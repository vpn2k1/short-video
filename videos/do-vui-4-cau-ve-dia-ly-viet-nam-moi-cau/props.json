{
  "title": "Thách thức địa lý",
  "subtitle": "4 câu về địa lý Việt Nam",
  "handle": "@dialyvietnam",
  "accent": "#00E5FF",
  "background": "#0F172A",
  "captions": [
    {
      "text": "Chỉ một phần mười người đúng hết!",
      "startMs": 2483,
      "endMs": 4543,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-01.mp3"
    },
    {
      "text": "Tỉnh nào có diện tích lớn nhất nước ta?",
      "startMs": 4693,
      "endMs": 6923,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-02.mp3"
    },
    {
      "text": "Suy nghĩ ba giây nhé.",
      "startMs": 7073,
      "endMs": 8493,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-03.mp3"
    },
    {
      "text": "Đáp án là Nghệ An.",
      "startMs": 8643,
      "endMs": 10193,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-04.mp3"
    },
    {
      "text": "Thành phố nào đông dân nhất cả nước?",
      "startMs": 10343,
      "endMs": 12383,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-05.mp3"
    },
    {
      "text": "Đoán nhanh nào.",
      "startMs": 12533,
      "endMs": 13473,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-06.mp3"
    },
    {
      "text": "Đáp án là Thành phố Hồ Chí Minh.",
      "startMs": 13623,
      "endMs": 15583,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-07.mp3"
    },
    {
      "text": "Đỉnh núi cao nhất Việt Nam là gì?",
      "startMs": 15733,
      "endMs": 17753,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-08.mp3"
    },
    {
      "text": "Bạn chọn gì?",
      "startMs": 17903,
      "endMs": 18863,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-09.mp3"
    },
    {
      "text": "Đáp án là Fansipan.",
      "startMs": 19013,
      "endMs": 20583,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-10.mp3"
    },
    {
      "text": "Sông nào dài nhất chảy qua Việt Nam?",
      "startMs": 20733,
      "endMs": 22783,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-11.mp3"
    },
    {
      "text": "Thử thách cuối cùng.",
      "startMs": 22933,
      "endMs": 24083,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-12.mp3"
    },
    {
      "text": "Đáp án là sông Mê Kông.",
      "startMs": 24233,
      "endMs": 25833,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-13.mp3"
    },
    {
      "text": "Bạn đúng mấy câu? Bình luận nhé!",
      "startMs": 25983,
      "endMs": 28093,
      "audio": "voices/do-vui-4-cau-ve-dia-ly-viet-nam-moi-cau/line-14.mp3"
    }
  ],
