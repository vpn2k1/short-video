{
  "title": "Thử tài đố mẹo",
  "subtitle": "3 câu đố con vật cực khó",
  "handle": "@dovui",
  "accent": "#FFD700",
  "background": "#1A1A1A",
  "captions": [
    {
      "text": "Chỉ một trong mười người đúng hết ba câu!",
      "startMs": 2483,
      "endMs": 4403,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-01.mp3"
    },
    {
      "text": "Con gì mang nhà đi khắp mọi nơi?",
      "startMs": 4553,
      "endMs": 6393,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-02.mp3"
    },
    {
      "text": "Suy nghĩ ba giây nhé.",
      "startMs": 6543,
      "endMs": 7743,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-03.mp3"
    },
    {
      "text": "Đáp án là con ốc sên.",
      "startMs": 7893,
      "endMs": 9413,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-04.mp3"
    },
    {
      "text": "Con gì sinh ra đã có bốn chân?",
      "startMs": 9563,
      "endMs": 11403,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-05.mp3"
    },
    {
      "text": "Đoán nhanh nào.",
      "startMs": 11553,
      "endMs": 12513,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-06.mp3"
    },
    {
      "text": "Đáp án là con cua.",
      "startMs": 12663,
      "endMs": 13943,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-07.mp3"
    },
    {
      "text": "Con gì không gáy mà ai cũng gọi là gà?",
      "startMs": 14093,
      "endMs": 16093,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-08.mp3"
    },
    {
      "text": "Bạn chọn gì?",
      "startMs": 16243,
      "endMs": 17123,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-09.mp3"
    },
    {
      "text": "Đáp án là gà trống giò.",
      "startMs": 17273,
      "endMs": 18793,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-10.mp3"
    },
    {
      "text": "Bạn đúng mấy câu? Bình luận nhé!",
      "startMs": 18943,
      "endMs": 20623,
      "audio": "voices/thu-tai-giai-ba-cau-do-meo-cuc-kho-ve-co/line-11.mp3"
    }
  ],
