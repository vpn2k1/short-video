  "captions": [
    {
      "text": "Bạn nghĩ Reels chỉ dựa vào lượt thích?",
      "startMs": 2483,
      "endMs": 4917,
      "audio": "voices/reels-thuc-su-phan-phoi-video-nhu-the-na/line-01.mp3"
    },
    {
      "text": "Thực tế, thuật toán còn sâu hơn.",
      "startMs": 5567,
      "endMs": 7965,
      "audio": "voices/reels-thuc-su-phan-phoi-video-nhu-the-na/line-02.mp3"
    },
    {
      "text": "30% video mới được đưa lên Explore ngay lập tức",
      "startMs": 8815,
      "endMs": 13128,
      "audio": "voices/reels-thuc-su-phan-phoi-video-nhu-the-na/line-03.mp3"
    },
    {
      "text": "Đó là cửa ngõ đầu tiên để lan truyền.",
      "startMs": 13378,
      "endMs": 16078,
      "audio": "voices/reels-thuc-su-phan-phoi-video-nhu-the-na/line-04.mp3"
    },
    {
      "text": "Bước 1: video dưới 15 giây giữ người xem lâu",
      "startMs": 16928,
      "endMs": 20777,
      "audio": "voices/reels-thuc-su-phan-phoi-video-nhu-the-na/line-05.mp3"
    },
    {
      "text": "Cứ mỗi giây xem, điểm số tăng lên.",
      "startMs": 21027,
      "endMs": 23657,
      "audio": "voices/reels-thuc-su-phan-phoi-video-nhu-the-na/line-06.mp3"
    },
    {
      "text": "Hãy thử áp dụng và xem lượt xem bùng nổ",
      "startMs": 24507,
      "endMs": 27497,
      "audio": "voices/reels-thuc-su-phan-phoi-video-nhu-the-na/line-07.mp3"
    },
    {
      "text": "Follow để nhận thêm bí quyết Reels",
      "startMs": 27747,
      "endMs": 30304,
      "audio": "voices/reels-thuc-su-phan-phoi-video-nhu-the-na/line-08.mp3"
    }
  ],
