{
  "title": "Một ngày ở xưởng gốm",
  "subtitle": "Clip tự quay, chỉ cắt gọn",
  "handle": "@kenh",
  "accent": "#ff6b2c",
  "background": "#0f1115",
  "captions": [
    {
      "text": "Sáng sớm, lò vẫn còn ấm từ đêm qua.",
      "startMs": 2483,
      "endMs": 5123,
      "audio": "voices/mot-ngay-o-xuong-gom/edit-1789705727572/line-01.mp3"
    },
    {
      "text": "Mẻ men mới pha trước khi trời nắng.",
      "startMs": 5666,
      "endMs": 7746,
      "audio": "voices/mot-ngay-o-xuong-gom/edit-1789705727572/line-02.mp3"
    },
    {
      "text": "Bàn xoay chạy, đất lên hình trong ba phút.",
      "startMs": 8236,
      "endMs": 10796,
      "audio": "voices/mot-ngay-o-xuong-gom/edit-1789705727572/line-03.mp3"
    },
    {
      "text": "Tay ướt, nhịp đều, không vội.",
      "startMs": 11283,
      "endMs": 13283,
      "audio": "voices/mot-ngay-o-xuong-gom/edit-1789705727572/line-04.mp3"
    },
    {
      "text": "Chiều nay ra lò mười hai chiếc.",
      "startMs": 13790,
      "endMs": 15550,
      "audio": "voices/mot-ngay-o-xuong-gom/edit-1789705727572/line-05.mp3"
    },
    {
      "text": "Hỏng hai, còn mười.",
      "startMs": 15943,
      "endMs": 17383,
      "audio": "voices/mot-ngay-o-xuong-gom/edit-1789705727572/line-06.mp3"
    }
  ],
