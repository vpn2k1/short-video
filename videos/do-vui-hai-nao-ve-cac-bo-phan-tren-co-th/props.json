{
  "title": "Bạn Hiểu Rõ Cơ Thể Mình",
  "subtitle": "3 câu đố vui về cơ thể người",
  "handle": "@kienthucsieucap",
  "accent": "#FACC15",
  "background": "#0F172A",
  "captions": [
    {
      "text": "Chỉ 1 trong 10 người đúng hết!",
      "startMs": 2483,
      "endMs": 4003,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-01.mp3"
    },
    {
      "text": "Xương nào dài và chắc nhất cơ thể người?",
      "startMs": 4153,
      "endMs": 6153,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-02.mp3"
    },
    {
      "text": "Suy nghĩ 3 giây nhé…",
      "startMs": 6303,
      "endMs": 7423,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-03.mp3"
    },
    {
      "text": "Đáp án là xương đùi.",
      "startMs": 7573,
      "endMs": 8853,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-04.mp3"
    },
    {
      "text": "Bộ phận duy nhất không có mạch máu là gì?",
      "startMs": 9003,
      "endMs": 11163,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-05.mp3"
    },
    {
      "text": "Đoán nhanh nào…",
      "startMs": 11313,
      "endMs": 12193,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-06.mp3"
    },
    {
      "text": "Đáp án là giác mạc.",
      "startMs": 12343,
      "endMs": 13463,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-07.mp3"
    },
    {
      "text": "Cơ quan nặng nhất trên cơ thể là gì?",
      "startMs": 13613,
      "endMs": 15533,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-08.mp3"
    },
    {
      "text": "Suy nghĩ thật kỹ nhé…",
      "startMs": 15683,
      "endMs": 16883,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-09.mp3"
    },
    {
      "text": "Đáp án là làn da.",
      "startMs": 17033,
      "endMs": 18233,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-10.mp3"
    },
    {
      "text": "Bạn đúng mấy câu? Bình luận nhé!",
      "startMs": 18383,
      "endMs": 20063,
      "audio": "voices/do-vui-hai-nao-ve-cac-bo-phan-tren-co-th/line-11.mp3"
    }
  ],
