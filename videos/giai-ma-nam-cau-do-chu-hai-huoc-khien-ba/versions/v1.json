{
  "title": "Đố chữ cười ngất",
  "subtitle": "5 câu đố chữ cực hài",
  "handle": "@docvui",
  "accent": "#FFD700",
  "background": "#1A1A1A",
  "captions": [
    {
      "text": "Chỉ một phần mười người đúng hết năm câu!",
      "startMs": 2483,
      "endMs": 4483,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-01.mp3"
    },
    {
      "text": "Con gì đập thì sống, không đập thì chết?",
      "startMs": 4633,
      "endMs": 6713,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-02.mp3"
    },
    {
      "text": "Suy nghĩ ba giây nhé.",
      "startMs": 6863,
      "endMs": 8063,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-03.mp3"
    },
    {
      "text": "Đáp án là trái tim.",
      "startMs": 8213,
      "endMs": 9493,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-04.mp3"
    },
    {
      "text": "Cái gì mà đi thì nằm, đứng thì nằm, nằm cũng nằm?",
      "startMs": 9643,
      "endMs": 12603,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-05.mp3"
    },
    {
      "text": "Đoán nhanh nào.",
      "startMs": 12753,
      "endMs": 13713,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-06.mp3"
    },
    {
      "text": "Đáp án là bàn chân.",
      "startMs": 13863,
      "endMs": 15143,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-07.mp3"
    },
    {
      "text": "Bệnh gì bác sĩ phải bó tay?",
      "startMs": 15293,
      "endMs": 16973,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-08.mp3"
    },
    {
      "text": "Bạn chọn gì?",
      "startMs": 17123,
      "endMs": 18003,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-09.mp3"
    },
    {
      "text": "Đáp án là gãy tay.",
      "startMs": 18153,
      "endMs": 19513,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-10.mp3"
    },
    {
      "text": "Con gì đầu dê mặt ngựa?",
      "startMs": 19663,
      "endMs": 21023,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-11.mp3"
    },
    {
      "text": "Suy nghĩ ba giây nhé.",
      "startMs": 21173,
      "endMs": 22373,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-12.mp3"
    },
    {
      "text": "Đáp án là con giốc.",
      "startMs": 22523,
      "endMs": 23723,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-13.mp3"
    },
    {
      "text": "Nhà nào không có cửa mà vẫn ở được?",
      "startMs": 23873,
      "endMs": 25873,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-14.mp3"
    },
    {
      "text": "Đoán nhanh nào.",
      "startMs": 26023,
      "endMs": 26983,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-15.mp3"
    },
    {
      "text": "Đáp án là nhà tù.",
      "startMs": 27133,
      "endMs": 28413,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-16.mp3"
    },
    {
      "text": "Bạn đúng mấy câu? Bình luận nhé!",
      "startMs": 28563,
      "endMs": 30243,
      "audio": "voices/giai-ma-nam-cau-do-chu-hai-huoc-khien-ba/line-17.mp3"
    }
  ],
