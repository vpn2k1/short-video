      "endMs": 9433,
      "audio": null
    },
    {
      "text": "Cá heo nói chuyện bằng tiếng còi",
      "startMs": 9583,
      "endMs": 12383,
      "audio": null
    },
    {
      "text": "Âm thanh truyền qua nước lên tới 30 km",
      "startMs": 12533,
      "endMs": 16133,
      "audio": null
    },
    {
      "text": "Chúng có trí nhớ xã hội mạnh mẽ",
      "startMs": 16283,
      "endMs": 19483,
      "audio": null
    },
    {
      "text": "Nhớ khu vực ăn cá suốt 10 năm",
      "startMs": 19633,
      "endMs": 22833,
      "audio": null
    },
    {
      "text": "Những con cá heo giúp người đánh cá",
      "startMs": 22983,
      "endMs": 26183,
      "audio": null
    },
    {
      "text": "Theo dõi để biết thêm điều kỳ diệu!",
