  "captions": [
    {
      "text": "Nhà khoa học xác nhận cá mập không mắc ung thư.",
      "startMs": 2483,
      "endMs": 5283,
      "audio": "voices/tao-mot-kien-thuc-thu-vi/line-01.mp3"
    },
    {
      "text": "Dữ liệu: 0% tỉ lệ ung thư trong 2.000 cá kiểm tra.",
      "startMs": 5433,
      "endMs": 9193,
      "audio": "voices/tao-mot-kien-thuc-thu-vi/line-02.mp3"
    },
    {
      "text": "Nghiên cứu chỉ ra cá mập có gen sửa DNA nhanh chóng.",
      "startMs": 9343,
      "endMs": 12863,
      "audio": "voices/tao-mot-kien-thuc-thu-vi/line-03.mp3"
    },
    {
      "text": "Gen này loại bỏ tế bào bất thường trước ung thư.",
      "startMs": 13013,
      "endMs": 15733,
      "audio": "voices/tao-mot-kien-thuc-thu-vi/line-04.mp3"
    },
    {
      "text": "Bạn muốn biết chi tiết cơ chế này?",
      "startMs": 15883,
      "endMs": 17803,
      "audio": "voices/tao-mot-kien-thuc-thu-vi/line-05.mp3"
    },
    {
      "text": "Nhấn theo dõi để nhận tin nghiên cứu mới.",
      "startMs": 17953,
      "endMs": 20433,
      "audio": "voices/tao-mot-kien-thuc-thu-vi/line-06.mp3"
    }
