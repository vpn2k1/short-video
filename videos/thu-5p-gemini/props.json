{
  "title": "Hệ Mặt Trời có gì",
  "subtitle": "Khám phá Mặt Trời và 8 hành tinh",
  "handle": "@khamphavuotru",
  "accent": "#F59E0B",
  "background": "#0F172A",
  "captions": [
    {
      "text": "Trung tâm hệ là Mặt Trời.",
      "startMs": 2483,
      "endMs": 4883,
      "audio": null
    },
    {
      "text": "Ngôi sao khổng lồ chiếu sáng tất cả.",
      "startMs": 5033,
      "endMs": 8233,
      "audio": null
    },
    {
      "text": "Nguồn năng lượng duy nhất của chúng ta.",
      "startMs": 8383,
      "endMs": 11583,
      "audio": null
    },
    {
      "text": "Sao Thủy nhỏ nhất và gần nhất.",
      "startMs": 11733,
      "endMs": 14533,
      "audio": null
    },
    {
      "text": "Nhiệt độ thay đổi cực kỳ khắc nghiệt.",
      "startMs": 14683,
      "endMs": 17883,
      "audio": null
    },
    {
      "text": "Ban ngày cực nóng ban đêm cực lạnh.",
      "startMs": 18033,
      "endMs": 21233,
      "audio": null
    },
    {
      "text": "Sao Kim nóng nhất hệ Mặt Trời.",
      "startMs": 21383,
      "endMs": 24183,
      "audio": null
    },
    {
      "text": "Hiệu ứng nhà kính giữ chân nhiệt lượng.",
      "startMs": 24333,
      "endMs": 27533,
      "audio": null
    },
    {
      "text": "Hành tinh sáng nhất trên bầu trời đêm.",
      "startMs": 27683,
      "endMs": 30883,
      "audio": null
    },
    {
      "text": "Trái Đất là nhà của chúng ta.",
      "startMs": 31033,
      "endMs": 33833,
      "audio": null
    },
    {
      "text": "Hành tinh duy nhất có sự sống.",
      "startMs": 33983,
      "endMs": 36783,
      "audio": null
    },
    {
      "text": "Đại dương xanh bao phủ phần lớn.",
      "startMs": 36933,
      "endMs": 39733,
      "audio": null
    },
    {
      "text": "Sao Hỏa mang sắc đỏ đặc trưng.",
      "startMs": 39883,
      "endMs": 42683,
      "audio": null
    },
    {
      "text": "Có ngọn núi lửa cao nhất hệ.",
      "startMs": 42833,
      "endMs": 45633,
      "audio": null
    },
    {
      "text": "Điểm đến tiếp theo của con người.",
      "startMs": 45783,
      "endMs": 48583,
      "audio": null
    },
    {
      "text": "Sao Mộc khổng lồ nhất vũ trụ.",
      "startMs": 48733,
      "endMs": 51533,
      "audio": null
    },
    {
      "text": "Vết đỏ lớn là cơn bão khổng lồ.",
      "startMs": 51683,
      "endMs": 54883,
      "audio": null
    },
    {
      "text": "Bảo vệ các hành tinh phía trong.",
      "startMs": 55033,
      "endMs": 57833,
      "audio": null
    },
    {
      "text": "Sao Thổ sở hữu vành đai đẹp.",
      "startMs": 57983,
      "endMs": 60783,
      "audio": null
    },
    {
      "text": "Được cấu tạo từ băng và đá.",
      "startMs": 60933,
      "endMs": 63733,
      "audio": null
    },
    {
      "text": "Hành tinh nhẹ nhất trong tất cả.",
      "startMs": 63883,
      "endMs": 66683,
      "audio": null
    },
    {
      "text": "Sao Thiên Vương lạnh giá kỳ lạ.",
      "startMs": 66833,
      "endMs": 69633,
      "audio": null
    },
    {
      "text": "Nó quay theo chiều ngang độc đáo.",
      "startMs": 69783,
      "endMs": 72583,
      "audio": null
    },
    {
      "text": "Bầu khí quyển chứa băng và khí.",
      "startMs": 72733,
      "endMs": 75533,
      "audio": null
    },
    {
      "text": "Sao Hải Vương xa xôi nhất.",
      "startMs": 75683,
      "endMs": 78083,
      "audio": null
    },
    {
      "text": "Gió thổi mạnh nhất hệ Mặt Trời.",
      "startMs": 78233,
      "endMs": 81033,
      "audio": null
    },
    {
      "text": "Hành tinh nào làm bạn ấn tượng nhất?",
      "startMs": 81183,
      "endMs": 84383,
      "audio": null
    }
  ],
