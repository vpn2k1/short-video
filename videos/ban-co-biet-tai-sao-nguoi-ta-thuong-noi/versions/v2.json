{
  "title": "Bạn có biết vì sao người ta nói không ai khó ba đời không?",
  "subtitle": "Nhà tôi là minh chứng đây!",
  "accent": "#ff6b2c",
  "background": "#0f1115",
  "captions": [
    {
      "text": "Nhà tôi là minh chứng đây!",
      "startMs": 2483,
      "endMs": 4003,
      "audio": "voices/ban-co-biet-tai-sao-nguoi-ta-thuong-noi/mugbhdqrij7/line-01.mp3"
    },
    {
      "text": "Đời ông tôi nghèo, đời bố tôi cũng nghèo.",
      "startMs": 4853,
      "endMs": 7173,
      "audio": "voices/ban-co-biet-tai-sao-nguoi-ta-thuong-noi/mugbhdqrij7/line-02.mp3"
    },
    {
      "text": "Đến đời tôi thì nghèo đến mức tiền lấy vợ còn không có.",
      "startMs": 7623,
      "endMs": 10903,
      "audio": "voices/ban-co-biet-tai-sao-nguoi-ta-thuong-noi/mugbhdqrij7/line-03.mp3"
    },
    {
      "text": "Nghĩ kỹ mới thấy câu này đúng thật!",
      "startMs": 11753,
      "endMs": 13833,
      "audio": "voices/ban-co-biet-tai-sao-nguoi-ta-thuong-noi/mugbhdqrij7/line-04.mp3"
    },
    {
      "text": "Vì tôi mà nghèo thế này thì lấy đâu ra vợ, không có vợ thì lấy đâu ra con?",
      "startMs": 14683,
      "endMs": 18843,
      "audio": "voices/ban-co-biet-tai-sao-nguoi-ta-thuong-noi/mugbhdqrij7/line-05.mp3"
    },
    {
      "text": "Nhà tôi không phải hết nghèo sau ba đời… mà là hết luôn đời thứ tư!",
      "startMs": 19893,
      "endMs": 23893,
      "audio": "voices/ban-co-biet-tai-sao-nguoi-ta-thuong-noi/mugbhdqrij7/line-06.mp3"
    }
  ],
