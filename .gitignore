node_modules
dist
# Bản đóng gói desktop (npm run dist:mac)
release
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Remotion bundle output
build

# Voiceover sinh ra cho từng video — sinh lại được từ script.json
public/voices

# AI có sẵn trong app: llama-server + model GGUF (npm run setup, ~1,1 GB)
vendor

# whisper.cpp + model tải về (1.3-1.5GB)
whisper.cpp
whisper.cpp-*

# Ghi công ảnh Pexels — giữ lại, cần khi đăng
!public/images/**/CREDITS.txt

# Cảnh render riêng
out/scenes

# File người dùng tải lên qua giao diện chat
public/uploads

# Thùng rác của app (Thư viện › Thùng rác)
.trash

# API key điền trong ô Cài đặt của giao diện web
data/api-keys.json
# Đã hiện popup gợi ý key lúc tạo video lần đầu
data/key-tips-seen

# Ảnh bìa cắt từ mp4 cho bảng làm hàng loạt — sinh lại được
public/thumbs

# Trạng thái từng loạt video (Hàng loạt)
data/batches
# Mẫu cài đặt loạt người dùng tự lưu
data/batch-presets.json

# Cờ "đang chạy" của từng video — còn sót sau khi server tắt nghĩa là lượt bị gián đoạn
videos/*/.running.json

# Thống kê lượt gọi dịch vụ theo ngày (⚙ Cài đặt › 📊 Hôm nay) — dữ liệu của từng máy
data/usage.json

# Kết quả tự soát video (scripts/qa-video.ts) — gắn với file mp4 trong out/, soát lại được bất cứ lúc nào
videos/*/qa.json
