{
  "title": "Từ nhỏ tôi đã không có vợ",
  "subtitle": "Câu chuyện đời tôi",
  "handle": "@kenh",
  "accent": "#ff6b2c",
  "background": "#0f1115",
  "captions": [
    {
      "text": "Lúc tôi mới sinh ra, không có ai đến thăm.",
      "startMs": 2483,
      "endMs": 5043,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-01.mp3"
    },
    {
      "text": "Tôi nằm trong nôi, nhìn xung quanh, không có vợ.",
      "startMs": 5193,
      "endMs": 8393,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-02.mp3"
    },
    {
      "text": "5 tuổi, vẫn không có vợ.",
      "startMs": 8543,
      "endMs": 10943,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-03.mp3"
    },
    {
      "text": "Tôi nghĩ chắc sau này sẽ có.",
      "startMs": 11093,
      "endMs": 12693,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-04.mp3"
    },
    {
      "text": "10 tuổi, cũng không.",
      "startMs": 12843,
      "endMs": 14763,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-05.mp3"
    },
    {
      "text": "Tôi vẫn chờ đợi.",
      "startMs": 14913,
      "endMs": 15953,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-06.mp3"
    },
    {
      "text": "Đến 18, tôi bắt đầu nhận ra.",
      "startMs": 16103,
      "endMs": 18503,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-07.mp3"
    },
    {
      "text": "Có lẽ vấn đề là tôi chưa đủ tuổi kết hôn.",
      "startMs": 18653,
      "endMs": 20973,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-08.mp3"
    },
    {
      "text": "Chờ thêm 10 năm, tới 30 tuổi, vẫn không có.",
      "startMs": 21123,
      "endMs": 24563,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-09.mp3"
    },
    {
      "text": "Lúc đó tôi mới hiểu ra một điều.",
      "startMs": 24713,
      "endMs": 26473,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-10.mp3"
    },
    {
      "text": "Từ nhỏ đến lớn, tôi chưa từng có vợ.",
      "startMs": 26623,
      "endMs": 28943,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-11.mp3"
    },
    {
      "text": "Và cho đến tận bây giờ, tôi vẫn chưa có.",
      "startMs": 29093,
      "endMs": 31573,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-12.mp3"
    },
    {
      "text": "Cuộc đời thật khó hiểu.",
      "startMs": 31723,
      "endMs": 33403,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-13.mp3"
    },
    {
      "text": "Câu chuyện của tôi vẫn chưa có kết thúc.",
      "startMs": 33553,
      "endMs": 35553,
      "audio": "voices/tu-nho-toi-da-khong-co-vo/line-14.mp3"
    }
  ],
  "aspect": "9:16",
