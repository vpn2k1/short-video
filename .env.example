# Copy thành .env (đã gitignore) rồi điền. Cả ba đều tuỳ chọn —
# thiếu cái nào thì chỉ mất bước tương ứng, không vỡ pipeline.

# Sinh kịch bản từ prompt. Thiếu → phải tự viết out/script.json.
ANTHROPIC_API_KEY=

# Voiceover ElevenLabs. Thiếu → dùng --tts say (giọng macOS).
ELEVENLABS_API_KEY=
# Không đặt thì script tự lấy voice đầu tiên và in ra tên. Nên đặt rõ.
# Sarah EXAVITQu4vr4xnSDxMaL | Alice Xb7hH8MSUJpSbSDYk0k2
# Laura FGY2WhTYpPnrIDTdsKH5 | George JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# Giọng macOS cho --tts say. Xem danh sách: say -v '?'
SAY_VOICE=Linh

# Model TTS. Mặc định eleven_v3 (hỗ trợ tiếng Việt chính thức).
# Hỗ trợ vi: eleven_v3, eleven_v3_conversational, eleven_flash_v2_5, eleven_turbo_v2_5
# eleven_multilingual_v2 KHÔNG hỗ trợ tiếng Việt — đừng dùng cho nội dung tiếng Việt.
ELEVENLABS_MODEL_ID=eleven_v3
